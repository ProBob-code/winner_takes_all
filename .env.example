# Frontend (apps/frontend) — public, bundled into the client build
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_LANDING_URL=/

# API (apps/api) — Cloudflare Worker secrets.
# Do NOT put real values here or in wrangler.toml. For local dev, create
# apps/api/.dev.vars (gitignored) with these keys. For deployed environments,
# set them with `wrangler secret put <NAME>` or as GitHub Actions repository
# secrets (used by .github/workflows/deploy-api.yml).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
